# Supabase connection
#
# Use the plain project URL, NOT a REST/Auth endpoint.
# Correct:   https://abcdefghijklmnop.supabase.co
# Incorrect: https://abcdefghijklmnop.supabase.co/rest/v1/
#
# supabase-js appends the service path itself. A URL that already ends in
# /rest/v1 or /auth/v1 makes every request hit a doubled path, which breaks
# login (reported as "Invalid email address or password") and stops products
# loading on the homepage.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Publishable key (sb_publishable_…) or the legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
